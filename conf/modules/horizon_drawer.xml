<!DOCTYPE module SYSTEM "module.dtd">

<module name="horizon_drawer">
  <doc>
    <description>
      This module processes the front camera image to detect the horizon...
    </description>
    <!--
      If you want a #define instead of a dynamic setting, you can skip the <settings> block.
      But if you want a GCS-tunable variable, you must declare it properly:
    -->
    <define name="HORIZON_THRESHOLD" value="50" description="Fallback define if needed."/>
  </doc>

  <!--
    DYNAMIC SETTINGS:
    The code that parses these is quite strict about requiring a 'type', 'default', 'min', 'max', etc.
  -->
  <settings>
    <dl_settings>
      <dl_settings name="DangerZone_and_EdgeDetection_Variables">
        <dl_setting var="middle_danger_zone" min="0" step="2" max="520" shortname="width_danger_zone"/>
        <dl_setting var="min_safe_dist" min="0" step="1" max="110" shortname="height_danger_zone"/>
        <dl_setting var="skip_percentage" min="0.0" step="0.05" max="0.45" shortname="what_percentage_of_side_to_skip"/>
        <dl_setting var="num_neighbors" min="0" step="1" max="150" shortname="number_of_neighbours_for_edge_detection"/>
        <dl_setting var="EDGE_THRESH" min="0" step="1" max="255" shortname="Edge_Threshold_for_edge_detection"/>
        <dl_setting var="heading_increment" min="0" step="1" max="50" shortname="heading_increment_for_edge_detection"/>
        <dl_setting var="heading_increment_obstacle_found" min="0" step="1" max="50" shortname="heading_increment_for_edge_detection_when_obstacle_found"/>
        <dl_setting var="max_trajectory_confidence" min="0" step="1" max="8" shortname="max_trajectory_confidence"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="horizon_drawer.h"/>
  </header>

  <init fun="horizon_drawer_init()"/>
  <periodic fun="horizon_drawer_periodic()" freq="4"/>

  <makefile target="ap|nps">
    <file name="horizon_drawer.c"/>
  </makefile>
</module>

